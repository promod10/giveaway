# Server Configuration
PORT=3001
MONGO_URI=mongodb://localhost:27017/giveaway

# YouTube Data API v3
# Get this from: https://console.cloud.google.com
# 1. Create a project
# 2. Enable "YouTube Data API v3"
# 3. Create an API Key
YOUTUBE_API_KEY=your_youtube_api_key_here

# Instagram Graph API
# Get this from: https://developers.facebook.com
# 1. Create a Facebook App
# 2. Add "Instagram Basic Display" product
# 3. Generate an access token
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here

# Facebook Graph API
# Get these from: https://developers.facebook.com
# 1. Use your existing Facebook App (or create new one)
# 2. Generate a page access token with "pages_read_engagement" permission
# 3. Get your page ID from Graph API Explorer
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here
FACEBOOK_PAGE_ID=your_facebook_page_id_here
